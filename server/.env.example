# Server Configuration
# Copy this file to `.env` and fill in real values
# DO NOT commit `.env` to source control!

# Port the server runs on (default: 3001)
PORT=3001

# MongoDB Connection String
# Option 1: Local MongoDB (if you have MongoDB installed locally)
# Use 127.0.0.1 rather than localhost: on Windows, `localhost` resolves to
# IPv6 (::1) first, while a default MongoDB install listens only on IPv4, so
# `localhost` fails with ECONNREFUSED ::1:27017 even though MongoDB is running.
# MONGODB_URI=mongodb://127.0.0.1:27017/chatapp

# Option 2: MongoDB Atlas (cloud - free tier available)
# Sign up at https://www.mongodb.com/atlas
# Create a cluster, then get your connection string
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/chatapp?retryWrites=true&w=majority

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# REQUIRED. The Firebase project whose ID tokens this server accepts.
# Must match `projectId` in src/firebase.js.
#
# Not a secret — it already ships in the frontend bundle. The server needs it
# to check a token's `aud` and `iss`, which is what stops a valid token minted
# for somebody else's Firebase project being replayed against this one.
#
# Note there is deliberately NO service-account key here. Verifying an ID
# token only needs Google's public certificates, so there is nothing secret to
# distribute and no Firebase Console step before the server will run.
FIREBASE_PROJECT_ID=your-project-id

# DEV ONLY — leave this unset.
#
# When set to exactly "true" (and NODE_ENV is not "production"), the server
# accepts an `X-Dev-User-Id` header in place of a real token. That exists so
# an automated browser, which cannot complete a Google sign-in popup, can
# drive the app, and so a role can be previewed without a second Google
# account.
#
# It turns authentication OFF for anyone who can reach the server. The server
# prints a loud warning at startup whenever it is on.
# ALLOW_DEV_AUTH=true

# ---------------------------------------------------------------------------
# Mentorship Copilot (the Python retrieval service in ai/)
# ---------------------------------------------------------------------------

# Where the retrieval service listens. Leave BOTH of these unset and the
# Copilot route answers 503 — the rest of the app runs, and the test suite
# passes, without Python or the Atlas Local container.
#
# It must stay a loopback address. The service trusts the mentorship id it is
# handed, because it cannot verify a Firebase token; Express is what checks
# that the caller is in that mentorship before calling it.
# AI_SERVICE_URL=http://127.0.0.1:8000

# Shared secret, sent as X-AI-Secret. Must match AI_SERVICE_SECRET in ai/.env.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# AI_SERVICE_SECRET=

# Signs the agent's per-turn capability tokens (lib/agentToken.js). Only this
# server holds it: never put it in ai/.env. At least 32 characters, and NOT the
# same as AI_SERVICE_SECRET, or the server refuses to start. Unset, the agent's
# tool endpoint answers 503 and nothing else changes.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AGENT_TOKEN_SECRET=

# Signs the agent's write proposals (lib/agentProposal.js). Only this server holds
# it: never put it in ai/.env. At least 32 characters, and different from both
# secrets above, or the server refuses to start. Unset, reads work and nothing can
# be proposed. Generate it the same way, separately.
# AGENT_PROPOSAL_SECRET=

# The panel uses the agent unless this says otherwise. off, or anything but
# on, 1 or true, gives S2's answer from search instead. Either way, only on the
# synthetic databases listed in code.
# COPILOT_AGENT=on

# Comma-separated addresses granted the `admin` role at sign-in.
#
# This is the ONLY way to become an admin. The first-login picker and the
# profile switcher offer student and mentor only, and the self-service role
# endpoint rejects anything else — so admin cannot be self-assigned by editing
# a request. Keeping the list in server config puts it somewhere a user cannot
# reach.
#
# Applied on every login: adding an address promotes that person next time
# they sign in. Removing one does not automatically demote; change the role
# from the admin dashboard.
#
# These are real addresses, so they do not go in this file or in server/.env: other
# tools work in this folder and can read any file in it. Put them in a file called
# server.env, beside the file the AI_ENV_FILE variable names (see ai/.env.example):
#
#     ADMIN_EMAILS=you@example.com,someone-else@example.com
#
# The server will not start without AI_ENV_FILE and that file. It may be empty.
