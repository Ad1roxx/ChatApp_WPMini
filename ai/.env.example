# Copy to ai/.env and adjust. The real .env is gitignored.

# The Atlas Local container, NOT the development database on 27017.
# $vectorSearch does not exist on a plain community server, which is the whole
# reason this is a second port.
AI_MONGODB_URI=mongodb://127.0.0.1:27018/?directConnection=true
AI_DB_NAME=chatapp_rag

# The shared secret Express presents on every call. The service also binds to
# localhost; this is the second lock, not the only one.
AI_SERVICE_SECRET=change-me-to-something-random

# 384 dimensions, CPU, free, offline after the first download. bge-small reads
# 512 tokens where all-MiniLM-L6-v2 read 256, at the same width — so the chunk
# budget below is reachable and the vector index needs no rebuild.
AI_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
AI_EMBEDDING_DIMS=384
AI_EMBEDDING_MAX_TOKENS=512

# Chunk sizing, in the embedding model's own tokens. The budget is a request:
# it is clamped to what the model above can actually read.
AI_CHUNK_BUDGET_TOKENS=400
AI_CHUNK_OVERLAP_TOKENS=60
AI_MIN_CHUNK_TOKENS=32

AI_HOST=127.0.0.1
AI_PORT=8000
