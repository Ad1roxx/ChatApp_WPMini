# Copy to ai/.env and adjust. The real .env is gitignored.
#
# No secrets in this file or in ai/.env: other tools work in this folder and can
# read any file in it, and the key scan fails if ai/.env holds one. The secrets go
# in a file outside the repository, named by the AI_ENV_FILE environment variable:
#
#     AI_ENV_FILE=%USERPROFILE%\.mentorconnect\ai.env
#
#     GEMINI_API_KEY=...
#     GROQ_API_KEY=...
#     AI_SERVICE_SECRET=something-long-and-random
#
# The service will not start without AI_ENV_FILE, and nothing that imports these
# settings will run if it names a file that is not there.

# The chunk store: the Atlas Local container. $vectorSearch does not exist on
# a plain community server, which is the whole reason this is a second port.
# Holds the served index and nothing else.
AI_MONGODB_URI=mongodb://127.0.0.1:27018/?directConnection=true
AI_DB_NAME=chatapp_rag

# The app's own database, where the records and attachments live. READ-ONLY
# from this service (appdb.py offers no write). In a deployment, give this
# service a database user with the `read` role on it and nothing more.
AI_APP_MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
AI_APP_DB_NAME=chatapp

# The evaluation fixture, on the chunk-store server: a seeded corpus and its
# own index. evaluate.py and check_retrieval.py use this, never the above.
AI_EVAL_DB_NAME=chatapp_eval

# AI_SERVICE_SECRET, in the AI_ENV_FILE file, is the shared secret Express presents
# on every call. The service also binds to localhost; this is the second lock, not
# the only one.

# 384 dimensions, CPU, free, offline after the first download. bge-small reads
# 512 tokens where all-MiniLM-L6-v2 read 256, at the same width — so the chunk
# budget below is reachable and the vector index needs no rebuild.
AI_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
AI_EMBEDDING_DIMS=384
AI_EMBEDDING_MAX_TOKENS=512

# Chunk sizing, in the embedding model's own tokens. The budget is a request:
# it is clamped to what the model above can actually read.
AI_CHUNK_BUDGET_TOKENS=400
AI_CHUNK_OVERLAP_TOKENS=60
AI_MIN_CHUNK_TOKENS=32

AI_HOST=127.0.0.1
AI_PORT=8000

# --- Generation (S2) ---------------------------------------------------------
# FREE TIERS, SYNTHETIC DATA ONLY (AGENT_PLAN 2.6): free-tier prompts may be
# used to improve the provider's products, so no real student work goes through
# either. Never set up billing on either provider.
#
# The keys are in the AI_ENV_FILE file (see the top of this file). A key missing
# from it leaves the ask route answering 503; search still works. Never commit
# them, and never paste one into a prompt or a log.

# gemini generates; groq is the documented fallback, chosen here - never tried
# automatically after a failure.
AI_LLM_PROVIDER=gemini
# Pinned by name, never a -latest alias. Re-check the provider's model list
# before each evaluation run: a pinned model can be withdrawn.
AI_GEMINI_MODEL=gemini-3.5-flash-lite
AI_GROQ_MODEL=openai/gpt-oss-120b
AI_GROQ_REASONING_EFFORT=low
# An answer that reaches the cap is an error, never shown.
AI_LLM_MAX_OUTPUT_TOKENS=400
# Gemini sends no rate-limit headers, so its calls are counted here, in a file
# every process using the key shares (the service, evaluation, smoke tests).
AI_GEMINI_RPM=15
# 480, not the published 500: Google refused calls when our count stood at 495.
AI_GEMINI_RPD=480
# AI_LLM_USAGE_FILE=ai/.llm-usage.json
